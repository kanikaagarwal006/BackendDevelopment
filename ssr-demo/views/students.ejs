<!DOCTYPE html>
<html>
<head>
  <title>Students</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <h1>Student List</h1>

  <table border="1">
    <tr>
      <th>Name</th>
      <th>Branch</th>
    </tr>

    <% students.forEach((student, index) => { %>
      <tr class="<%= index % 2 === 0 ? 'row-even' : 'row-odd' %>">
        <td><%= student.name %></td>
        <td><%= student.branch %></td>
      </tr>
    <% }) %>

  </table>

</body>
</html>